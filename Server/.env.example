# FlightBag data server configuration. Copy to .env next to docker-compose.yml.

# The absolute URL clients reach this server at — baked into every product URL
# in manifest.json, so it MUST be right (your NAS LAN IP or, later, a domain).
# Re-run ingest after changing it to rebuild the manifest.
FLIGHTBAG_BASE_URL=http://192.168.1.50:8080

# Host port the server publishes on.
FLIGHTBAG_PORT=8080

# Where multi-GB artifacts and ingest intermediates live. On a NAS point these
# at the storage pool; both must be writable by the container user.
FLIGHTBAG_ARTIFACTS_DIR=./Public/artifacts
FLIGHTBAG_WORKDIR=./ingest-work

# --- Ingest scope --------------------------------------------------------
# Each accepts: all | none | comma list. The airport/nav database always
# builds; charts are opt-in because "all" is roughly 100+ GB per cycle.
# Sectional names are FAA file names (see ChartCatalog.vfrSectionals).
FLIGHTBAG_SECTIONALS=San_Antonio,Houston
# Plate regions are states: US-TX,US-OK (bare TX works too).
FLIGHTBAG_REGIONS=US-TX
# IFR enroute panels: low 1-36, high 1-12 (56-day editions, every other cycle).
FLIGHTBAG_IFR_LOW_PANELS=none
FLIGHTBAG_IFR_HIGH_PANELS=none
# Offline basemap: auto = build once, reuse forever | always | never.
FLIGHTBAG_BASEMAP=auto
# Worldwide airports/navaids from OurAirports (public domain), layered under
# NASR — which stays authoritative for the US. Adds ~25 MB to aero.sqlite and
# roughly 47 000 non-US aerodromes. Set to 0 for a US-only database.
FLIGHTBAG_GLOBAL_AIRPORTS=1

# Abort ingest when the workdir volume has less free space than this.
FLIGHTBAG_MIN_FREE_GB=50

# Optional: POSTed a plain-text failure message by scripts/ingest-cron.sh
# when an ingest run exits nonzero (e.g. an ntfy.sh or Slack webhook URL).
#FLIGHTBAG_FAIL_WEBHOOK=
